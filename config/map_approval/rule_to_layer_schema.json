{
  "schema_name": "lda_residential_cad_rule_to_layer_schema",
  "version": "1.0.0",
  "purpose": "Deterministic CAD entity mapping and rule validation schema for residential approval.",
  "unit_system": {
    "length": "ft",
    "area": "sqft",
    "ratio": "far"
  },
  "layer_groups": {
    "site": ["A-WALL", "boundary wall", "SITE-FBL", "SITE-PL", "SITE-SB", "SITE-RMP", "SITE-LS"],
    "reference": ["REF-DP", "REF-DIM", "REF-DIMS", "REF-SEC", "REF-TXT"],
    "basement": ["BSM-WE", "BSM-WI", "BSM-DR", "BSM-WN", "BSM-ST", "BSM-TXT", "BSM-SRV"],
    "ground_floor": ["GF-WE", "GF-WI", "GF-DR", "GF-WN", "GF-ST", "GF-PR", "GF-TR", "GF-TXT", "GF-SRV"],
    "first_floor": ["FF-WE", "FF-WI", "FF-DR", "FF-WN", "FF-ST", "FF-TR", "FF-BL", "FF-TXT", "FF-SRV"],
    "second_floor": ["SF-WE", "SF-WI", "SF-DR", "SF-WN", "SF-ST", "SF-TR", "SF-BL", "SF-TXT", "SF-SRV"],
    "roof": ["RF-MUM", "RF-WT", "RF-SLR", "RF-PW", "RF-TXT"],
    "components": ["CMP-WIN", "CMP-WND", "CMP-VNT", "CMP-W1"],
    "structure": ["STR-COL", "STR-BM", "STR-SLB"],
    "materials": ["MAT-H1", "MAT-H2", "MAT-PAV", "MAT-TL", "MAT-GR"],
    "utilities": ["UTIL-SWR", "UTIL-WTR", "UTIL-ELC"]
  },
  "layer_definitions": {
    "A-WALL": { "description": "Plot boundary wall / outer site boundary line", "category": "site", "tag": "plot_boundary", "processing_role": "approval_geometry_fallback" },
    "boundary wall": { "description": "Plot boundary wall / outer site boundary line", "category": "site", "tag": "plot_boundary", "processing_role": "approval_geometry_fallback" },
    "SITE-FBL": { "description": "Front setback / front building control line", "category": "site", "tag": "front_setback", "processing_role": "reference_supporting" },
    "SITE-PL": { "description": "Plot dimensions / legal plot line", "category": "site", "tag": "plot_boundary", "processing_role": "approval_geometry_primary" },
    "SITE-SB": { "description": "Mandatory setback lines (front)", "category": "site", "tag": "setback", "processing_role": "reference_supporting" },
    "SITE-RMP": { "description": "Vehicle ramp porch", "category": "site", "tag": "ramp", "processing_role": "approval_geometry_supporting" },
    "SITE-LS": { "description": "Lawn / green area / open space", "category": "site", "tag": "landscape", "processing_role": "display_only" },
    "REF-DP": { "description": "AutoCAD default definition/reference points / inbuilt", "category": "reference", "tag": "defpoints", "processing_role": "ignore_for_approval_geometry" },
    "REF-DIM": { "description": "Main dimension line layer", "category": "reference", "tag": "dimension", "processing_role": "annotation_only" },
    "REF-DIMS": { "description": "Dimension text / secondary dimensions", "category": "reference", "tag": "dimensions", "processing_role": "annotation_only" },
    "REF-SEC": { "description": "Section indicators (AA/BB etc.)", "category": "reference", "tag": "section", "processing_role": "annotation_only" },
    "REF-TXT": { "description": "General notes / annotations", "category": "reference", "tag": "text", "processing_role": "annotation_only" },
    "BSM-WE": { "description": "External walls on basement floor", "category": "basement", "tag": "basement_external_walls", "processing_role": "approval_geometry_primary" },
    "BSM-WI": { "description": "Internal walls on basement floor", "category": "basement", "tag": "basement_internal_walls", "processing_role": "layout_review_only" },
    "BSM-DR": { "description": "Doors on basement floor", "category": "basement", "tag": "basement_doors", "processing_role": "layout_review_only" },
    "BSM-WN": { "description": "Windows / roshandan / ventilators on basement", "category": "basement", "tag": "basement_windows", "processing_role": "layout_review_only" },
    "BSM-ST": { "description": "Staircase from basement to ground floor", "category": "basement", "tag": "basement_stairs", "processing_role": "layout_review_only" },
    "BSM-TXT": { "description": "Labels/text for basement floor", "category": "basement", "tag": "basement_text", "processing_role": "annotation_only" },
    "BSM-SRV": { "description": "water tank / utilities", "category": "basement", "tag": "basement_services", "processing_role": "approval_geometry_supporting" },
    "GF-WE": { "description": "External walls on ground floor", "category": "ground_floor", "tag": "ground_external_walls", "processing_role": "approval_geometry_primary" },
    "GF-WI": { "description": "Internal walls on ground floor", "category": "ground_floor", "tag": "ground_internal_walls", "processing_role": "layout_review_only" },
    "GF-DR": { "description": "Doors on ground floor", "category": "ground_floor", "tag": "ground_doors", "processing_role": "layout_review_only" },
    "GF-WN": { "description": "Windows on ground floor", "category": "ground_floor", "tag": "ground_windows", "processing_role": "layout_review_only" },
    "GF-ST": { "description": "Staircase from ground to first floor", "category": "ground_floor", "tag": "ground_stairs", "processing_role": "layout_review_only" },
    "GF-PR": { "description": "Porch / car porch", "category": "ground_floor", "tag": "ground_porch", "processing_role": "approval_geometry_supporting" },
    "GF-TR": { "description": "Open terrace / shaft / courtyard", "category": "ground_floor", "tag": "ground_terrace", "processing_role": "layout_review_only" },
    "GF-TXT": { "description": "Labels/text for ground floor", "category": "ground_floor", "tag": "ground_text", "processing_role": "annotation_only" },
    "GF-SRV": { "description": "Kitchen/toilet shafts/services", "category": "ground_floor", "tag": "ground_services", "processing_role": "approval_geometry_supporting" },
    "FF-WE": { "description": "External walls on first floor", "category": "first_floor", "tag": "first_external_walls", "processing_role": "approval_geometry_primary" },
    "FF-WI": { "description": "Internal walls on first floor", "category": "first_floor", "tag": "first_internal_walls", "processing_role": "layout_review_only" },
    "FF-DR": { "description": "Doors on first floor", "category": "first_floor", "tag": "first_doors", "processing_role": "layout_review_only" },
    "FF-WN": { "description": "Windows on first floor", "category": "first_floor", "tag": "first_windows", "processing_role": "layout_review_only" },
    "FF-ST": { "description": "Staircase from first to second floor", "category": "first_floor", "tag": "first_stairs", "processing_role": "layout_review_only" },
    "FF-TR": { "description": "Terrace/open roof on first floor", "category": "first_floor", "tag": "first_terrace", "processing_role": "layout_review_only" },
    "FF-BL": { "description": "Balcony on first floor", "category": "first_floor", "tag": "first_balcony", "processing_role": "layout_review_only" },
    "FF-TXT": { "description": "Labels/text for first floor", "category": "first_floor", "tag": "first_text", "processing_role": "annotation_only" },
    "FF-SRV": { "description": "Toilets/shafts/services", "category": "first_floor", "tag": "first_services", "processing_role": "approval_geometry_supporting" },
    "SF-WE": { "description": "External walls on second floor", "category": "second_floor", "tag": "second_external_walls", "processing_role": "approval_geometry_primary" },
    "SF-WI": { "description": "Internal walls on second floor", "category": "second_floor", "tag": "second_internal_walls", "processing_role": "layout_review_only" },
    "SF-DR": { "description": "Doors on second floor", "category": "second_floor", "tag": "second_doors", "processing_role": "layout_review_only" },
    "SF-WN": { "description": "Windows on second floor", "category": "second_floor", "tag": "second_windows", "processing_role": "layout_review_only" },
    "SF-ST": { "description": "Staircase on second floor", "category": "second_floor", "tag": "second_stairs", "processing_role": "layout_review_only" },
    "SF-TR": { "description": "Terrace/open roof on second floor", "category": "second_floor", "tag": "second_terrace", "processing_role": "layout_review_only" },
    "SF-BL": { "description": "Balcony on second floor", "category": "second_floor", "tag": "second_balcony", "processing_role": "layout_review_only" },
    "SF-TXT": { "description": "Labels/text for second floor", "category": "second_floor", "tag": "second_text", "processing_role": "annotation_only" },
    "SF-SRV": { "description": "Toilets/shafts/services", "category": "second_floor", "tag": "second_services", "processing_role": "approval_geometry_supporting" },
    "RF-MUM": { "description": "Stair cover / mumty structure", "category": "roof", "tag": "mumty", "processing_role": "approval_geometry_supporting" },
    "RF-WT": { "description": "Overhead water tank", "category": "roof", "tag": "water_tank", "processing_role": "approval_geometry_supporting" },
    "RF-SLR": { "description": "Solar panel layout", "category": "roof", "tag": "solar", "processing_role": "layout_review_only" },
    "RF-PW": { "description": "Roof parapet wall", "category": "roof", "tag": "parapet_wall", "processing_role": "approval_geometry_supporting" },
    "RF-TXT": { "description": "Roof annotations", "category": "roof", "tag": "roof_text", "processing_role": "annotation_only" },
    "CMP-WIN": { "description": "Standard window elements", "category": "components", "tag": "window", "processing_role": "layout_review_only" },
    "CMP-WND": { "description": "Detailed window annotations", "category": "components", "tag": "window_detailed", "processing_role": "layout_review_only" },
    "CMP-VNT": { "description": "Ventilator / roshandan", "category": "components", "tag": "ventilator", "processing_role": "layout_review_only" },
    "CMP-W1": { "description": "Special wall type / wall marking", "category": "components", "tag": "wall_special", "processing_role": "layout_review_only" },
    "STR-COL": { "description": "Structural columns", "category": "structure", "tag": "columns", "processing_role": "document_evidence_only" },
    "STR-BM": { "description": "Structural beams", "category": "structure", "tag": "beams", "processing_role": "document_evidence_only" },
    "STR-SLB": { "description": "Slab edges / slab references", "category": "structure", "tag": "slab", "processing_role": "document_evidence_only" },
    "MAT-H1": { "description": "Primary hatch / material fill", "category": "materials", "tag": "hatch_primary", "processing_role": "ignore_for_approval_geometry" },
    "MAT-H2": { "description": "Secondary hatch / alternate fill", "category": "materials", "tag": "hatch_secondary", "processing_role": "ignore_for_approval_geometry" },
    "MAT-PAV": { "description": "Pavement / paving / flooring", "category": "materials", "tag": "pavement", "processing_role": "display_only" },
    "MAT-TL": { "description": "Floor tile finish", "category": "materials", "tag": "tile", "processing_role": "display_only" },
    "MAT-GR": { "description": "Landscape hatch", "category": "materials", "tag": "grass", "processing_role": "display_only" },
    "UTIL-SWR": { "description": "Sewerage line", "category": "utilities", "tag": "sewer", "processing_role": "document_evidence_only" },
    "UTIL-WTR": { "description": "Water supply line", "category": "utilities", "tag": "water_supply", "processing_role": "document_evidence_only" },
    "UTIL-ELC": { "description": "Electrical layout", "category": "utilities", "tag": "electric", "processing_role": "document_evidence_only" }
  },
  "semantic_entities": {
    "plot_boundary": {
      "source_layers": ["SITE-PL", "A-WALL", "boundary wall"],
      "preferred_layer": "SITE-PL",
      "must_be_closed": true,
      "required": true,
      "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"],
      "used_for": ["plot_area", "width", "depth", "setbacks", "ground_coverage", "far"]
    },
    "ground_floor_covered_polygon": {
      "source_layers": ["GF-WE"],
      "must_be_closed": true,
      "required": true,
      "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"],
      "selection_rule": "outermost_closed_polygon_inside_plot_from_ground_external_walls"
    },
    "basement_covered_polygon": { "source_layers": ["BSM-WE"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "first_floor_covered_polygon": { "source_layers": ["FF-WE"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "second_floor_covered_polygon": { "source_layers": ["SF-WE"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "front_building_line": { "source_layers": ["SITE-FBL"], "must_be_closed": false, "required": false, "allowed_entity_types": ["LINE", "LWPOLYLINE", "POLYLINE"] },
    "setback_lines": { "source_layers": ["SITE-SB"], "must_be_closed": false, "required": false, "allowed_entity_types": ["LINE", "LWPOLYLINE", "POLYLINE"] },
    "ground_porch_polygon": { "source_layers": ["GF-PR", "SITE-RMP"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "ground_services_polygon": { "source_layers": ["GF-SRV"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "first_floor_services_polygon": { "source_layers": ["FF-SRV"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "second_floor_services_polygon": { "source_layers": ["SF-SRV"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "roof_mumty": { "source_layers": ["RF-MUM"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "roof_parapet_wall": { "source_layers": ["RF-PW"], "must_be_closed": true, "required": false, "allowed_entity_types": ["LWPOLYLINE", "POLYLINE"] },
    "utilities": { "source_layers": ["UTIL-SWR", "UTIL-WTR", "UTIL-ELC"], "must_be_closed": false, "required": false, "allowed_entity_types": ["LINE", "LWPOLYLINE", "POLYLINE"] },
    "annotations_and_dimensions": {
      "source_layers": ["REF-DIM", "REF-DIMS", "REF-SEC", "REF-TXT", "BSM-TXT", "GF-TXT", "FF-TXT", "SF-TXT", "RF-TXT"],
      "must_be_closed": false,
      "required": false,
      "allowed_entity_types": ["TEXT", "MTEXT", "LINE", "LWPOLYLINE", "POLYLINE"],
      "used_for": ["label_detection", "dimension_cross_check", "expert_review_display_only"]
    }
  },
  "calculation_inputs": {
    "ground_coverage_percent": ["plot_boundary", "ground_floor_covered_polygon"],
    "far": ["plot_boundary", "ground_floor_covered_polygon", "first_floor_covered_polygon", "second_floor_covered_polygon"],
    "setbacks": ["plot_boundary", "ground_floor_covered_polygon", "front_building_line", "setback_lines"],
    "porch": ["ground_porch_polygon"],
    "rear_toilet_services": ["ground_services_polygon", "first_floor_services_polygon", "second_floor_services_polygon"]
  },
  "rules_to_layers": {
    "SETBACK_FRONT": ["SITE-PL", "GF-WE"],
    "SETBACK_REAR": ["SITE-PL", "GF-WE"],
    "SETBACK_SIDE": ["SITE-PL", "GF-WE"],
    "GROUND_COVERAGE": ["SITE-PL", "GF-WE"],
    "FAR_LIMIT": ["SITE-PL", "GF-WE", "FF-WE", "SF-WE"],
    "MAX_STOREYS": ["GF-WE", "FF-WE", "SF-WE"],
    "MAX_HEIGHT": ["REF-DIM", "REF-DIMS", "REF-TXT"],
    "STOREY_CLEAR_HEIGHT": ["REF-DIM", "REF-DIMS", "REF-TXT"],
    "PORCH_LENGTH": ["GF-PR", "SITE-RMP"],
    "PORCH_ROOM_NOT_ALLOWED": ["GF-PR", "FF-WE"],
    "REAR_TOILET_AREA": ["GF-SRV", "FF-SRV", "SF-SRV"],
    "BASEMENT_VALIDATION": ["BSM-WE"],
    "STRUCTURAL_DRAWINGS": ["STR-COL", "STR-BM", "STR-SLB"],
    "WATER_SUPPLY_SEWERAGE_DRAINAGE_PLAN": ["UTIL-SWR", "UTIL-WTR"],
    "ELECTRICITY_SAFETY_PLAN": ["UTIL-ELC"],
    "FIRE_SAFETY_PLAN": ["GF-ST", "FF-ST", "SF-ST", "GF-DR", "FF-DR", "SF-DR"]
  },
  "layer_processing_policy": {
    "ignore_for_geometry_categories": ["reference", "materials"],
    "internal_wall_tags_not_for_area": ["basement_internal_walls", "ground_internal_walls", "first_internal_walls", "second_internal_walls"],
    "approval_geometry_only_external_wall_tags": ["basement_external_walls", "ground_external_walls", "first_external_walls", "second_external_walls"]
  },
  "entity_selection_scoring": {
    "auto_accept_score": 85,
    "needs_review_score": 60,
    "weights": {
      "layer_match": 45,
      "preferred_layer_bonus": 15,
      "closed_bonus": 20,
      "entity_type_bonus": 10,
      "inside_plot_bonus": 10
    }
  },
  "threejs_display_policy": {
    "auto_mapped": "#2e9a4f",
    "needs_expert_review": "#f3c43b",
    "missing_required": "#d64040",
    "ignored": "#94979d",
    "manual_mapped": "#2b6ce1"
  },
  "validation_blocking_policy": {
    "required_semantic_entities": ["plot_boundary", "ground_floor_covered_polygon"],
    "block_validation_when_missing_required": true,
    "uncertain_mapping_requires_expert_review": true
  }
}
