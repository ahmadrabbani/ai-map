    "evaluation_flow": [
        "Normalise units for plot and floor data.",
        "Derive context such as plot band, FAR, coverage, storeys, floor roles, and use mix.",
        "Select active rules through conditional activation.",
        "Resolve precedence using overlays, local clauses, external hooks, then defaults.",
        "Evaluate plot-wide metrics before floor-level checks.",
        "Emit pass, warn, or fail with clause references and measured values."
    ],
    "comparison_matrix": [
        {
            "plot_bucket": "small",
            "ground_floor": "Tight envelope with highest coverage bands and earliest height limits.",
            "mid_floors": "Checks focus on clear height, stairs, and room/layout predicates.",
            "upper_floors": "Overall caps on storeys and height dominate compliance."
        },
        {
            "plot_bucket": "medium",
            "ground_floor": "Setbacks widen and ground coverage drops compared with small plots.",
            "mid_floors": "Parking, lift, disabled-access, and fire checks activate more often.",
            "upper_floors": "Emergency stairs, hydrants, and stability submissions become important."
        },
        {
            "plot_bucket": "large",
            "ground_floor": "Largest setbacks and lowest residential coverage percentages apply.",
            "mid_floors": "Multi-storey fire, lift, and service-floor compliance dominate review.",
            "upper_floors": "High-rise pathways require local zoning plus external-code hooks."
        }
    ],
    "implementation_assumptions": [
        "Applicable to all plot sizes and floors means evaluable for all, not that every clause always applies.",
        "Mixed-use proposals should be decomposed into separate use components and then recombined.",
        "Where the regulation delegates to other codes, the engine should emit external-code tasks instead of inventing local numeric limits.",
        "Special-area overlays should be supported as separate rule packs."
    ],
    "normalized_rules": [
        {
            "id": "R1_RESIDENTIAL_APPROVED_SCHEME_ENVELOPE",
            "title": "Approved-scheme residential storeys, coverage, height and FAR by plot size",
            "rule_type": "height_limit",
            "scope": "building",
            "applicability": {
                "zones": ["residential"],
                "subzones": ["approved_scheme"],
                "floor_selector": {
                    "type": "all"
                }
            },
            "evaluation": {
                "mode": "band_lookup",
                "result_fields": [
                    "max_storeys_excluding_basement",
                    "max_ground_coverage_percent",
                    "max_height_ft",
                    "max_far"
                ],
                "bands": [
                    {
                        "when": {
                            "all_of": [
                                {"subject": "plot_area_sqft", "operator": "<", "value": 1125}
                            ]
                        },
                        "requirements": [
                            {"subject": "max_storeys_excluding_basement", "operator": "=", "value": 3},
                            {"subject": "max_ground_coverage_percent", "operator": "=", "value": 80},
                            {"subject": "max_height_ft", "operator": "=", "value": 38, "unit": "ft"},
                            {"subject": "max_far", "operator": "=", "value": 2.4, "unit": "far"}
                        ]
                    },
                    {
                        "when": {
                            "all_of": [
                                {"subject": "plot_area_sqft", "operator": ">=", "value": 1125},
                                {"subject": "plot_area_sqft", "operator": "<", "value": 2250}
                            ]
                        },
                        "requirements": [
                            {"subject": "max_storeys_excluding_basement", "operator": "=", "value": 3},
                            {"subject": "max_ground_coverage_percent", "operator": "=", "value": 75},
                            {"subject": "max_height_ft", "operator": "=", "value": 38, "unit": "ft"},
                            {"subject": "max_far", "operator": "=", "value": 2.3, "unit": "far"}
                        ]
                    },
                    {
                        "when": {
                            "all_of": [
                                {"subject": "plot_area_sqft", "operator": ">=", "value": 2250},
                                {"subject": "plot_area_sqft", "operator": "<", "value": 9000}
                            ]
                        },
                        "requirements": [
                            {"subject": "max_storeys_excluding_basement", "operator": "=", "value": 4},
                            {"subject": "max_ground_coverage_percent", "operator": "=", "value": "70_to_60_by_band"},
                            {"subject": "max_height_ft", "operator": "=", "value": 45, "unit": "ft"},
                            {"subject": "max_far", "operator": "=", "value": "2.8_to_2.4_by_band", "unit": "far"}
                        ]
                    }
                ]
            },
            "source_refs": [
                "Clauses 2.2.2-2.2.3 / supplied PDF pp.13-14"
            ]
        },
        {
            "id": "R2_SUBMISSION_PACKAGE",
            "title": "Mandatory submission package for approval",
            "rule_type": "submission",
            "scope": "building",
            "applicability": {
                "zones": ["residential", "commercial", "industrial", "public", "mixed_use"],
                "floor_selector": {
                    "type": "all"
                }
            },
            "evaluation": {
                "mode": "document_requirement",
                "requirements": [
                    {"subject": "document.water_supply_sewerage_drainage_plan", "operator": "exists", "value": true},
                    {"subject": "document.structural_drawings", "operator": "exists", "value": true},
                    {"subject": "document.electricity_safety_plan", "operator": "exists", "value": true},
                    {"subject": "document.fire_safety_plan", "operator": "exists", "value": true}
                ]
            },
