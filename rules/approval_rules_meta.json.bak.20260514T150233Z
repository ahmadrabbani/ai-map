        {
            "term": "far",
            "meaning": "Aggregate covered area divided by total plot area.",
            "source_ref": "Clause 1.1 / supplied PDF p.5"
        },
        {
            "term": "ground_coverage",
            "meaning": "Ground floor covered area as a percentage of total plot area.",
            "source_ref": "Residential controls / supplied PDF pp.13-14"
        }
